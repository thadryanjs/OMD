# Ignore everything at the repo root...
/*
# ...except these
!.gitignore
!/code/
!/math/
!/scripts/

# Inside the kept dirs: ignore all files, but keep descending into subdirs
code/**
math/**
scripts/**
!code/**/
!math/**/
!scripts/**/

# Track only these extensions, at any depth inside the kept dirs
!**/*.R
!**/*.py
!**/*.md
!**/*.tex
!**/*.sh
!**/*.yaml
!**/*.yml
!**/*.toml
!**/*.lock
!**/.gitignore

# Re-ignore junk as whole directories (nothing inside gets tracked)
code/outputs/
code/.pytest_cache/
code/.ruff_cache/
**/*.egg-info/

# .pixi is ignored EXCEPT one file:
# ignore its *contents*, not the dir itself, so the file can be rescued
code/.pixi/*
!code/.pixi/config.toml
